# Minimal application bootstrap
NODE_ENV=development
PORT=3000

# PostgreSQL is required. `npm run deploy` creates the bundled database values
# and a strong password automatically. Set these manually only for local
# development or when using an external database. DATABASE_URL takes precedence.
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=telnyx_genesys
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_POOL_MAX=10
PGSSLMODE=disable

# Required 32-byte AES key encoded as base64 (or 64 hexadecimal characters).
# Generated automatically by `npm run deploy` (or by `npm run genesys:deploy`
# outside Docker). Back it up in the
# deployment platform's secret manager; losing it makes DB secrets unrecoverable.
ADMIN_SECRETS_MASTER_KEY=

# The installation key/name plus Genesys, Telnyx, OAuth, AudioHook, Open
# Messaging, widget-session and handoff credentials are encrypted in
# PostgreSQL. Do not add them to this file.
